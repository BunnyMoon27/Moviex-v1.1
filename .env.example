# Copy this file to .env and configure MongoDB. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27018/moviex_handoff?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
API_PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
